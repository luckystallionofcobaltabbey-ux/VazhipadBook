# GEMINI_API_KEY: Optional server-side Gemini API key (configured via runtime secrets, never prefixed with VITE_).
GEMINI_API_KEY=

# APP_URL: Public URL where this application is hosted.
APP_URL=http://localhost:3000

# Optional Firebase Web Config overrides (otherwise read from local firebase-applet-config.json)
# Note: Never commit .env or firebase-applet-config.json to version control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Optional Admin Console Google Email override
VITE_ADMIN_EMAIL=
